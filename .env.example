# ==============================================================================
# Instagram & Facebook Automation Environment Variables Template
# Copy this file to '.env' before running in production or testing with live APIs:
#   copy .env.example .env
#
# IMPORTANT:
# - Never commit the actual '.env' file to source control.
# - Keep all secrets, tokens, and keys secure.
# ==============================================================================

# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ==============================================================================
# Meta App Credentials (Required for Phase 2 integration)
# Obtain these from: https://developers.facebook.com/apps/
# ==============================================================================

# Your Meta App ID and App Secret (from Meta App Dashboard -> App settings -> Basic)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version (e.g., v21.0)
META_GRAPH_API_VERSION=v21.0

# Base URL for Meta Graph API
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Webhook Verification Token:
# A secret string that YOU define. You must provide the exact same token in the
# Meta App Dashboard under Webhooks -> Instagram -> Verify Token.
META_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# ==============================================================================
# Instagram & Page Credentials (Required for Phase 2 integration)
# ==============================================================================

# Page Access Token:
# A long-lived access token with permissions to manage Instagram messages and comments.
# Required permissions:
# - instagram_manage_comments
# - instagram_manage_messages
# - pages_manage_metadata
# - pages_read_engagement
META_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Instagram Professional (Business/Creator) Account ID connected to your Facebook Page
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ==============================================================================
# Automation Rule Settings
# ==============================================================================

# Keyword trigger (optional):
# Leave empty to trigger on any comment, or specify a keyword like "LINK", "INFO", "SEND"
AUTO_DM_TRIGGER_KEYWORD=

# Predefined message / link sent via DM in response to valid comments
# Note: Meta policy permits one automated private reply per comment within 7 days.
AUTO_DM_RESPONSE_MESSAGE=Hey! Thanks for commenting. Here is the link you requested: https://example.com
